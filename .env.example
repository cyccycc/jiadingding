# SQLite 文件。路径相对项目根目录。
DATABASE_URL="file:./data/jiadingding.db"

# 会话 Cookie 的 HMAC 密钥，请换成足够长的随机字符串。
SESSION_SECRET="change-me-to-a-long-random-string"

# GET /api/cron/check 使用的密钥。
CRON_SECRET="change-me-cron-secret"

# 设为 true 时，Next.js 进程内每 CHECK_INTERVAL_MS 毫秒检查一次已启用的盯价。
ENABLE_SCHEDULER="false"
CHECK_INTERVAL_MS="60000"

# 留空则不发 SMTP，改为打印日志并写入 data/outbox/*.json。
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="价盯盯 <notify@localhost>"
# 465 端口通常设为 true；587 使用 STARTTLS 时保持 false。
SMTP_SECURE="false"
